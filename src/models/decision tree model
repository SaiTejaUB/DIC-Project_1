import pandas as pd
useful_columns = [
    'Severity','Start_Time','Distance(mi)','State',
    'Temperature(F)', 'Humidity(%)','Pressure(in)',
    'Visibility(mi)', 'Wind_Speed(mph)','Precipitation(in)',
    'Weather_Condition','Sunrise_Sunset'
]
d_map = {
    'Severity':'int8',
    'Distance(mi)':'float32',
    'Temperature(F)':'float32',
    'Humidity(%)':'float32',
    'Pressure(in)':'float32',
    'Visibility(mi)':'float32',
    'Wind_Speed(mph)':'float32',
    'Precipitation(in)':'float32',
    'State':'category',
    'Weather_Condition':'category',
    'Sunrise_Sunset':'category'
}
df = pd.read_csv('/content/drive/MyDrive/us_accidents_cleaned_full.csv',usecols=useful_columns,dtype=d_map)
print(df.shape)
print(df.columns)
print(df.head())
df['Start_Time']=pd.to_datetime(df['Start_Time'],errors='coerce')
print(df['Start_Time'].dtype)
print(df['Start_Time'].isna().sum())
features = [
    'Distance(mi)','Temperature(F)','Humidity(%)','Pressure(in)',
    'Visibility(mi)','Wind_Speed(mph)','Precipitation(in)',
    'State','Weather_Condition','Sunrise_Sunset','Hour','Month'
]
target ='Severity'
print(df.shape)
print(df.isnull().sum())
print(df[target].value_counts().sort_index())
x=df[features]
y=df[target]
from sklearn.model_selection import train_test_split
x_train,x_test,y_train,y_test = train_test_split(
    x,y,test_size=0.2,random_state=42,stratify=y
)
print(x_train.shape)
print(x_test.shape)
print(y_train.value_counts().sort_index())
print(y_test.value_counts().sort_index())
x_train,x_test,y_train,y_test = train_test_split(
    x,y,test_size=0.2,random_state=42,stratify=y
)
print(x_train.shape)
print(x_test.shape)
print(y_train.value_counts().sort_index())
print(y_test.value_counts().sort_index())
sample_size=400000
x_train_sample,_,y_train_sample,_ = train_test_split(
    x_train,y_train,train_size=sample_size,random_state=42,stratify=y_train
)
print(x_train_sample.shape)
print(y_train_sample.shape)
print(y_train_sample.value_counts().sort_index())
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import OneHotEncoder
categorical = ['State','Weather_Condition','Sunrise_Sunset']
numeric = [
    'Distance(mi)','Temperature(F)','Humidity(%)','Pressure(in)',
    'Visibility(mi)','Wind_Speed(mph)','Precipitation(in)','Hour','Month'
]
print(categorical)
print(numeric)
pre= ColumnTransformer(
    transformers=[
        ('cat',OneHotEncoder(handle_unknown='ignore'),categorical),
        ('num','passthrough',numeric)
    ]
)
from sklearn.pipeline import Pipeline
from sklearn.tree import DecisionTreeClassifier
pipe=Pipeline([
    ('prep',pre),
    ('model', DecisionTreeClassifier(random_state=43))
])
print(pipe)
from sklearn.model_selection import GridSearchCV
param_grid = {
    'model__max_depth':[5,10,15,20],
    'model__min_samples_split':[2,10,20],
    'model__min_samples_leaf':[1,5,10]
}
grid=GridSearchCV(pipe,param_grid,cv=5,n_jobs=-1,scoring='f1_weighted')
grid.fit(x_train_sample,y_train_sample)
print("Parameters:",grid.best_params_)
best = grid.best_params_
final=Pipeline([
    ('prep', pre),
    ('model', DecisionTreeClassifier(
        max_depth=best['model__max_depth'],
        min_samples_split=best['model__min_samples_split'],
        min_samples_leaf=best['model__min_samples_leaf'],
        random_state=42
    ))
])
final.fit(x_train, y_train)
y_pred = final.predict(x_test)
from sklearn.metrics import accuracy_score, f1_score, classification_report
print("accuracy:",accuracy_score(y_test,y_pred))
print("weighted F1:",f1_score(y_test,y_pred,average='weighted'))
print("macroF1:",f1_score(y_test,y_pred,average='macro'))
print("\nClassification Report:\n")
print(classification_report(y_test,y_pred,zero_division=0))
